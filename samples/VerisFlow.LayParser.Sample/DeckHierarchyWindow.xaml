<Window x:Class="VerisFlow.VenusDeckParser.Desktop.DeckHierarchyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Layout Hierarchy" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="X-Axis Display Range:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <TextBlock Text="Min X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="MinXTextBox" Width="60" Height="24" VerticalContentAlignment="Center" Margin="0,0,15,0" />

                <TextBlock Text="Max X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="MaxXTextBox" Width="60" Height="24" VerticalContentAlignment="Center" Margin="0,0,15,0" />

                <Button Content="Apply Filter" Width="100" Height="26" Click="ApplyFilter_Click"
                        Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <TreeView x:Name="HierarchyTreeView" BorderThickness="0" Padding="5">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Path x:Name="IconPath" Width="14" Height="14" Fill="#555555" Margin="0,0,6,0" Stretch="Uniform"/>
                            <TextBlock Text="{Binding DisplayText}" FontWeight="{Binding FontWeight}" VerticalAlignment="Center"/>

                            <!-- X, Y, Z coordinates with distinct colors for the axis labels -->
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#777777">
                                <Run Text="["/>
                                <Run Text="X:" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FinalX, StringFormat={}{0:F3}}"/>
                                <Run Text=", "/>
                                <Run Text="Y:" Foreground="#388E3C" FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FinalY, StringFormat={}{0:F3}}"/>
                                <Run Text=", "/>
                                <Run Text="Z:" Foreground="#1976D2" FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FinalZ, StringFormat={}{0:F3}}"/>
                                <Run Text="]"/>
                            </TextBlock>

                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCarrier}" Value="True">
                                <Setter TargetName="IconPath" Property="Data" Value="M4,4H20V8H4V4M4,10H20V14H4V10M4,16H20V20H4V16Z" />
                                <Setter TargetName="IconPath" Property="Fill" Value="#0078D7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCarrier}" Value="False">
                                <Setter TargetName="IconPath" Property="Data" Value="M7,2H17A2,2 0 0,1 19,4V20A2,2 0 0,1 17,22H7A2,2 0 0,1 5,20V4A2,2 0 0,1 7,2M7,4V20H17V4H7Z" />
                                <Setter TargetName="IconPath" Property="Fill" Value="#E08214"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </Grid>
</Window>