<Window x:Class="VerisFlow.VenusAuto.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerisFlow Venus Auto"
        Width="1040" Height="940"
        MinWidth="900" MinHeight="640"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="BgSurface"   Color="#2A2A3E"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#7C6AF7"/>
        <SolidColorBrush x:Key="AccentCyan"  Color="#5BC8AF"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#E0A040"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8888AA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3E3E5A"/>

        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="Background"               Value="#252538"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="CaretBrush"               Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableField" TargetType="TextBox">
            <Setter Property="Background"               Value="#252538"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="CaretBrush"               Value="{StaticResource AccentBlue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E5A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2E2E4A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,6,0,3"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <!-- Fixed-height rows on top; the dialogs and log row takes the remaining height. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16162A" Height="44">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" Margin="0,0,8,0"/>
                    <TextBlock Text="Venus Auto Test Bench" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Working..." Foreground="{StaticResource AccentAmber}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Column="2" Background="#252538" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="SemiBold">
                        <Run Text="F2"/>
                        <Run Text=" — Capture window under the cursor" Foreground="{StaticResource TextMuted}"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: capture, action tester, engine control -->
        <Grid Grid.Row="1" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.6*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2.6*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Capture -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel DataContext="{Binding CurrentCapture}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Target Properties" Style="{StaticResource SectionHeader}"/>
                        <Border Margin="8,0,0,0" Background="#1E2E3E" CornerRadius="3" Padding="6,2">
                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                       Foreground="{StaticResource AccentCyan}" FontSize="11" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource BorderColor}" Margin="0,0,0,2"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HWND" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding HwndText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Control ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ControlIdText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"
                                     Foreground="{StaticResource AccentCyan}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Class Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ClassName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Style" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StyleText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Window Text" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding WindowText, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource ReadOnlyField}" Height="34" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Parent" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ParentHwndText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Top-level" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RootHwndText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Owner of top-level" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RootOwnerHwndText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Absolute (X, Y)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AbsoluteText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Relative (X, Y)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RelativeText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"
                                     Foreground="{StaticResource AccentCyan}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Process ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ProcessId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Pixel Color" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="26"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding PixelColor, FallbackValue=Transparent}"/>
                            </Border.Background>
                        </Border>
                        <TextBox Grid.Column="2" Text="{Binding ColorHex, Mode=OneWay}"
                                 IsReadOnly="True" Style="{StaticResource ReadOnlyField}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action tester (raw input on the captured window) -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Action Tester" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderColor}" Margin="0,0,0,8"/>

                    <TextBlock Text="Raw input on the captured window, independent of the library."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <TextBlock Text="MOUSE" Style="{StaticResource GroupLabel}" Margin="0,10,0,4"/>
                    <Border Background="#1A2535" BorderBrush="#3A5A7A"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Button Content="Test Relative Click"
                                Command="{Binding TestClickCommand}"
                                Style="{StaticResource ActionButton}"/>
                    </Border>

                    <TextBlock Text="KEYBOARD" Style="{StaticResource GroupLabel}" Margin="0,10,0,4"/>
                    <Border Background="#1E1A2E" BorderBrush="#4A3A6A"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Text to send ({F5} only):" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TestInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26" Style="{StaticResource EditableField}" Margin="0,0,0,8"/>
                            <Button Content="Test Send Keys"
                                    Command="{Binding TestTextCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Engine control -->
            <Border Grid.Column="4"
                    Background="#18242A" BorderBrush="#2A5C54"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Engine Control" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Rectangle Height="1" Fill="#2A5C54" Margin="0,0,0,4"/>

                    <TextBlock Text="RUN" Style="{StaticResource GroupLabel}"/>
                    <UniformGrid Columns="2">
                        <Button Content="Start"  Command="{Binding StartCommand}"
                                Style="{StaticResource ActionButton}" Background="#2B7A6A" Margin="0,0,3,3"/>
                        <Button Content="Status" Command="{Binding StatusCommand}"
                                Style="{StaticResource ActionButton}" Background="#2B7A6A" Margin="3,0,0,3"/>
                        <Button Content="Pause"  Command="{Binding PauseCommand}"
                                Style="{StaticResource ActionButton}" Background="#B57628" Margin="0,0,3,0"/>
                        <Button Content="Resume" Command="{Binding ResumeCommand}"
                                Style="{StaticResource ActionButton}" Background="#2B7A6A" Margin="3,0,0,0"/>
                    </UniformGrid>

                    <TextBlock Text="WINDOW" Style="{StaticResource GroupLabel}"/>
                    <UniformGrid Columns="2">
                        <Button Content="Ensure Started" Command="{Binding EnsureStartedCommand}"
                                Style="{StaticResource ActionButton}" Background="#3A75C4" Margin="0,0,3,0"/>
                        <Button Content="Arrange (Right)" Command="{Binding ArrangeWindowCommand}"
                                Style="{StaticResource ActionButton}" Background="#3A75C4" Margin="3,0,0,0"/>
                    </UniformGrid>

                    <TextBlock Text="ABORT" Style="{StaticResource GroupLabel}"/>
                    <UniformGrid Columns="2">
                        <Button Content="Request Abort" Command="{Binding RequestAbortCommand}"
                                ToolTip="Clicks Abort and leaves the confirmation open (confirm: false)."
                                Style="{StaticResource ActionButton}" Background="#8A5A3A" Margin="0,0,3,0"/>
                        <Button Content="Confirm Abort" Command="{Binding ConfirmAbortCommand}"
                                ToolTip="Aborts and confirms (confirm: true)."
                                Style="{StaticResource ActionButton}" Background="#A63D40" Margin="3,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: method loading -->
        <Border Grid.Row="2" Margin="12,8,12,0"
                Background="#18242A" BorderBrush="#2A5C54"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Method Loading" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Open command + file dialog by control ID"
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBox Grid.Column="2" Text="{Binding MethodFilePath}"
                         IsReadOnly="True" Style="{StaticResource ReadOnlyField}"
                         Height="30" VerticalAlignment="Center"/>

                <Button Grid.Column="4" Content="Browse…"
                        Command="{Binding BrowseMethodCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,0" VerticalAlignment="Center"/>

                <Button Grid.Column="6" Content="Load Method"
                        Command="{Binding LoadMethodCommand}"
                        Style="{StaticResource ActionButton}"
                        Padding="16,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 3: dialogs and log, filling the remaining height -->
        <Grid Grid.Row="3" Margin="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Dialogs -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Run Control Dialogs" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoRefreshDialogs}" Content="Auto-refresh (1 s)"
                                  Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Read Dialogs" Command="{Binding ReadDialogsCommand}"
                                Style="{StaticResource SecondaryButton}" Height="26"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding DialogSummary}" Foreground="{StaticResource TextMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Last child of the DockPanel: fills the remaining space and scrolls. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Dialogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1A2E" BorderBrush="#4A3A6A" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextPrimary}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}"
                                                       FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextPrimary}"
                                                       FontSize="12" TextWrapping="Wrap"/>

                                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Buttons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding ToolTip}"
                                                                Style="{StaticResource SecondaryButton}" Height="28" Margin="0,8,6,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Log -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Log" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}" Height="26"/>
                    </Grid>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource ReadOnlyField}" FontSize="11"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="LogBox_TextChanged"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>