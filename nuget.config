<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear any machine-level sources to guarantee deterministic builds -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- If "Package source" is a required internal feed, define its path or URL here -->
    <!-- <add key="Package source" value="C:\Your\Local\Packages" /> -->
    <add key="LocalFeed" value="C:\LocalNuGetFeed" />
  </packageSources>

  <!-- Explicitly map package patterns to their trusted sources -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- Route all packages to nuget.org by default -->
      <package pattern="*" />
    </packageSource>
    
    <!-- If you use the secondary source for internal packages, map them explicitly -->
    <!--
    <packageSource key="Package source">
      <package pattern="VerisFlow.Internal.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>