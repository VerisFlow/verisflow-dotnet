<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>

        <PackageId>VerisFlow.TraceLogic.Core</PackageId>
        <Version>0.2.0</Version>
        <Authors>VerisFlow</Authors>
        <Company>VerisFlow</Company>
        <Description>Parser, locator, diagnostic error extractor, and exporter for Hamilton Venus trace log (.trc) files.</Description>
        <PackageTags>venus;trace;log;parser;pipetting;liquid-handling;error-diagnostics</PackageTags>
        <PackageReleaseNotes>Added error parsing support, syntax error detection, and TraceErrorInfo model extraction from Hamilton Venus trace logs.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <!-- Ensures reproducible binaries by normalizing source file paths when running in CI environments -->
    <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

</Project>
