<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
        <Version>0.1.0</Version>

        <!-- Package Identification and Namespace Alignment -->
        <PackageId>VerisFlow.Server</PackageId>
        <Title>VerisFlow.Server</Title>
        <RootNamespace>VerisFlow.Server</RootNamespace>
        <AssemblyName>VerisFlow.Server</AssemblyName>

        <Description>Server-side hosting and hub abstraction library for VerisFlow control services.</Description>
        <PackageTags>verisflow;server;signalr;aspnetcore;automation</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <!-- Ensures reproducible binaries by normalizing source file paths when running in CI environments -->
    <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Threading.Channels"/>
    </ItemGroup>

</Project>